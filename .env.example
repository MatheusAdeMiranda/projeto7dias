# copie este arquivo para `.env` antes de rodar o Docker Compose
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=uptime
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/uptime
REDIS_URL=redis://redis:6379/0
WORKER_CHECK_INTERVAL=10
